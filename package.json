{
  "name": "@sudobility/music_spatial",
  "version": "0.0.34",
  "description": "First-person 3D 'Spatial' stage view for Moosiac scores (web/Three.js) — wireframe instrument models, arrangement map overlay, movement.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && node scripts/fix-esm-imports.mjs",
    "clean": "rimraf dist",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "verify": "bun run format:check && bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.0.0",
    "@sudobility/music_spatial_core": "^0.0.30",
    "@sudobility/music_types": "^0.13.62",
    "react": ">=18",
    "react-dom": ">=18",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@react-three/fiber": "~9.8.2",
    "@sudobility/music_spatial_core": "^0.0.30",
    "@sudobility/music_types": "^0.13.62",
    "@testing-library/react": "~16.3.3",
    "@types/react": "~19.3.0",
    "@types/three": "~0.186.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "globals": "~17.13.0",
    "jsdom": "~30.1.3",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "rimraf": "~6.1.3",
    "three": "~0.186.1",
    "typescript": "~6.0.3",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/music_spatial.git"
  },
  "license": "BUSL-1.1"
}
